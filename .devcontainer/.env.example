# Dedicated state repo for artifact persistence across owners.
# The repo will be auto-created by /opsx-new if it does not exist.
OPENSPEC_STATE_REPO=https://github.com/org/openspec-state.git

# GitHub personal access token (or GitHub App token) with repo scope.
# Used for pushing state and auto-creating the state repo.
GIT_TOKEN=ghp_...

# Jira auth is handled by Cursor MCP settings (Atlassian MCP server),
# not by environment variables.
